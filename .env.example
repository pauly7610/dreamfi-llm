# DreamFi
DATABASE_URL=postgresql+psycopg://dreamfi:dreamfi@localhost:5433/dreamfi
LOG_LEVEL=INFO

# Console/API access
# Browser users can sign in with HTTP Basic auth using this username/password.
DREAMFI_AUTH_ENABLED=true
DREAMFI_AUTH_USERNAME=dreamfi
DREAMFI_AUTH_PASSWORD=change-me-before-deploy
# API clients may use Authorization: Bearer <token> instead of Basic auth.
DREAMFI_API_TOKEN=change-me-before-deploy

# Onyx
ONYX_BASE_URL=http://localhost:8080
ONYX_API_KEY=onyx_pat_XXX

# LLM (used only if DreamFi generates outside Onyx)
ANTHROPIC_API_KEY=sk-ant-XXX
OPENAI_API_KEY=sk-XXX
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022
# JSON list; the OpenAI fallback tracks the current frontier model family.
FALLBACK_LLM_MODELS=["claude-3-5-haiku-20241022","gpt-5.5"]

# Thresholds (optional overrides)
DREAMFI_CONFIDENCE_THRESHOLD=0.75
DREAMFI_IMPROVEMENT_THRESHOLD=0.02
DREAMFI_FRESHNESS_HALFLIFE_DAYS=14
DREAMFI_ASK_SEARCH_LIMIT=5
DREAMFI_CLAIM_LINEAGE_TARGET_CITATIONS=3
DREAMFI_MIN_OUTPUTS_PER_EVAL_INPUT=1
DREAMFI_MAX_OUTPUTS_PER_EVAL_INPUT=10
DREAMFI_PROBE_CONNECTOR_STATUS=true
DREAMFI_CONNECTOR_PROBE_SEARCH_LIMIT=1
DREAMFI_CONNECTOR_STALE_AFTER_DAYS=14
DREAMFI_CONNECTOR_HTTP_TIMEOUT_SECONDS=20
DREAMFI_CONNECTOR_SYNC_BATCH_SIZE=50
# Required if DreamFi stores custom connector API keys from the Settings page.
# Use a long random value, or a Fernet key generated with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DREAMFI_CONNECTOR_SECRET_KEY=change-me-before-deploy
DREAMFI_WORKFLOW_MIN_CITATIONS=1
DREAMFI_WORKFLOW_MIN_SECTION_WORDS=3
DREAMFI_WORKFLOW_REQUIRE_SCOPE=true
DREAMFI_AUDIT_ENABLED=true
DREAMFI_AUDIT_LOG_READS=true
DREAMFI_LEARNING_CLUSTER_MIN_COUNT=2
DREAMFI_LEARNING_CLUSTER_WINDOW_DAYS=30
DREAMFI_LEARNING_STALE_FRESHNESS_THRESHOLD=0.5
DREAMFI_LEARNING_REPLAY_DEFAULT_CADENCE_DAYS=7
DREAMFI_SKILL_MINING_MIN_TRACES=3
DREAMFI_SKILL_MINING_WINDOW_DAYS=30
DREAMFI_SKILL_MINING_EVAL_SEED_LIMIT=5
DREAMFI_SLO_HARD_GATE_PASS_RATE=0.8
DREAMFI_SLO_BLOCKED_RATE=0.2
DREAMFI_SLO_PUBLISH_SUCCESS_RATE=0.75
DREAMFI_BACKUP_DIR=backups
DREAMFI_BACKUP_RETENTION_DAYS=14
DREAMFI_BACKUP_MAX_FILES=30
